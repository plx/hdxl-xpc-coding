# XPCCoding source API stability baseline.
#
# This file pins the first hardened public API surface of the XPCCoding
# product. `Scripts/verify-api-stability.sh` and CI diff the working tree
# against this revision with
# `swift package diagnose-api-breaking-changes <revision> --products XPCCoding`.
#
# The baseline is a commit SHA, not a released semantic tag. XPCCoding's
# pre-hardening lightweight tags (0.0.1, 0.0.2, 0.0.3) predate the audited API
# surface and are intentionally not used as the going-forward baseline. See
# reference/ApiStabilityPolicy.md for the full policy and for how this baseline
# is advanced when a deliberate pre-1.0 break ships.
#
# Integrity: the verify script confirms that the revision still resolves to a
# commit and that its tree hash is unchanged, so a rewritten or mistyped pin
# fails loudly instead of silently diffing against the wrong source.

# The audited hardened surface (main @ 5f6480e, "Audit and constrain inlining
# exposure", #93). This is the same revision this release branch is based on.
XPCCODING_BASELINE_REVISION=5f6480ec450eb6a1067d183d62d47476f2ca5b4b
XPCCODING_BASELINE_TREE=8e83b35f3a5aaac22209bb0bc469070ac11b1efd

# The XPCCoding library product is the audited surface. The benchmarks
# executable is a development tool and is intentionally excluded.
XPCCODING_BASELINE_PRODUCT=XPCCoding
